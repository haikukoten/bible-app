# Copy to .env.local and fill in values from Contentful → Settings → API keys
# (Space ID + Content Delivery API token + optional Preview token)

NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
NEXT_PUBLIC_CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Public site URL (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://asbible.com

# Server-only (never NEXT_PUBLIC_)
OPENAI_API_KEY=
CRON_SECRET=
CONTENTFUL_REVALIDATE_SECRET=
CONTENTFUL_PREVIEW_SECRET=
