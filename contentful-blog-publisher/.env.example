# MiniMax: https://platform.minimax.io/
MINIMAX_API_KEY=sk-cp-j5GCZalMuvlXWzzq7c-tO-e10wxay2P1bZ0ZpXzzbQPiMYU6MrpRy6G1U9_7bWxep2oZSJm18978zysZwztewKYRwaDkPV_zXgOZkX-zZFTXak_vmJdq5pY

# Chat model for brief + article JSON
MINIMAX_TEXT_MODEL=MiniMax-M3

# Black Forest Labs API key for Flux image generation: https://dashboard.bfl.ai/
BFL_API_KEY=

# BFL Flux Image Model (flux-2-pro, flux-pro-1.1, etc.)
BFL_IMAGE_MODEL=flux-2-pro

# BFL Flux Image size
BFL_IMAGE_SIZE=1024x1024

# Contentful Space ID (same as NEXT_PUBLIC_CONTENTFUL_SPACE_ID on the site).
CONTENTFUL_SPACE_ID=

# Content **Management** API token only (Settings → API → Content management tokens).
# Do NOT paste the Content Delivery API token here — you will get 403 AccessTokenInvalid.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_BLOG_CONTENT_TYPE_ID=blog
CONTENTFUL_LOCALE=en-US

# GitHub: classic PAT with **gist** scope (Fine-grained: “Gists” read/write or classic `gist` scope)
GITHUB_TOKEN=

# Public gists off by default (private gists)
GIST_PUBLIC=false

# Scheduler: delay before the first run after a fresh state file (ms). Default 0 = first batch runs immediately.
FIRST_RUN_DELAY_MS=0

# Posts per cycle (each cycle is ~3 days + jitter). Default 2 = two topics per run, then advance by 2.
POSTS_PER_RUN=2

# Optional: custom path to config.txt (default ./config.txt)
# CONFIG_PATH=/opt/asbible/config.txt
